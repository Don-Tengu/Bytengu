{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current TypeScript file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
