{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug login",
      "type": "bun",
      "request": "launch",
      "runtime": "bun",
      "program": "${workspaceFolder}/src/login.ts",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    },
    {
      "name": "Debug current TypeScript file",
      "type": "bun",
      "request": "launch",
      "runtime": "bun",
      "program": "${file}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
